<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is permitted so S3 sync can reach a self-hosted server on the LAN (MinIO, RustFS).
     Use an https endpoint for anything reachable from the internet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
