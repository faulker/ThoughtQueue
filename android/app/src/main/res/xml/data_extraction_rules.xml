<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ form of backup_rules.xml: never back up or transfer the encrypted S3 secret. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="thoughtqueue_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="thoughtqueue_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
